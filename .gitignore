# Any SQLite database under data/ — glob rather than per-file, because the
# per-file rules did not cover ad-hoc copies (data/logs-prod.sqlite,
# logs-snap.sqlite, ...) and qa_log holds real student question text.
data/*.sqlite
data/*.sqlite-*
data/*.sqlite3
data/web_users
data/course_code_pattern_audit.json
data/host_metrics.json
data/url_source_map.json
data/url_filtered_links_report.json
data/program_aliases.json
# Auto-generated by `eval/survey_studyplans.py`; mirrors program_aliases.json.
data/study_plan_field_inventory.json

# Student-submitted jargon proposals — review with `student-bot-jargon proposals`
# and move accepted entries to dictionary.json before pushing.
data/dictionary_proposals.json

